# Production overrides (vite build = mode production; этот файл перекрывает .env)
# Dev (npm run dev) этот файл НЕ читает — там остаётся mock-auth из .env.
# Решение Босса 28.08: прод = реальный Google OAuth через auth-worker (не mock).
VITE_USE_MOCK_AUTH=false
VITE_AUTH_WORKER_URL=https://belive-auth.nikitosss007.workers.dev
