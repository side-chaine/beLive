---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import SoonNote from '../components/SoonNote.astro';
import { softwareApplication, faqPage, howTo, breadcrumbList } from '../lib/schema.mjs';

const title = 'Распевка онлайн: 10 минут перед пением — beLive';
const description =
  'Программа распевки на 10 минут: дыхание, мычание, гласные по полутонам, арпеджио. Что действительно готовит голос, а что вредит.';

const faq = [
  {
    q: 'Сколько должна длиться распевка?',
    a: 'Восемь-двенадцать минут. Пятнадцать — верхняя граница для любителя, дальше начинается усталость, а не разогрев. Короткая распевка каждый день полезнее, чем долгая раз в неделю.',
  },
  {
    q: 'Можно ли распеваться сразу в полный голос?',
    a: 'Нет, и это главная причина сорванных занятий. Первые две-три минуты — тихо, на средней громкости и в удобном диапазоне. Громкость добавляется последней, когда координация уже настроена.',
  },
  {
    q: 'Нужен ли инструмент для распевки?',
    a: 'Желателен: он даёт точку отсчёта, по которой слышно попадание. Если инструмента нет, подойдёт трек с понятной мелодией на медленном темпе — но тогда сложнее заметить, что вы уехали по высоте.',
  },
  {
    q: 'Правда ли, что утром голос хуже?',
    a: 'Утром голосовой аппарат менее подвижен, а диапазон часто уже обычного. Это нормально и не требует «продавливания»: пяти минут спокойных упражнений обычно достаточно, чтобы вернуться к рабочему состоянию.',
  },
  {
    q: 'Вредно ли петь без распевки?',
    a: 'Разово — нет. Систематически — точность ниже, а риск перенапряжения выше, потому что неподготовленный голос хуже держит высокие ноты и длинные фразы. Распевка не ритуал, а настройка.',
  },
  {
    q: 'Можно ли распева́ться шёпотом?',
    a: 'Не стоит. Шёпот нагружает связки не меньше обычной речи, а контроля меньше. Если нужно заниматься тихо — пойте вполголоса на удобных нотах, это безопаснее.',
  },
  {
    q: 'Что делать, если после распевки голос устал?',
    a: 'Скорее всего, было слишком громко или слишком долго. На следующий день сократите время и громкость вдвое. Усталость после распевки — сигнал перебора, а не признак хорошей работы.',
  },
];

const schemas = [
  softwareApplication({
    description:
      'Веб-студия для репетиций и вокала: минусовки, стемы, петли, смена тональности и темпа, разбор трека по частям.',
  }),
  faqPage(faq),
  howTo({
    name: 'Как распеться перед пением в студии beLive',
    description: 'Три шага: медленный трек, петля на фразе, постепенное ускорение до рабочего темпа.',
    steps: [
      {
        name: 'Поставьте медленный темп',
        text: 'Возьмите фразу из песни, которую собираетесь петь, и замедлите её до комфортной скорости. Тональность оставьте своей — распевка не должна требовать героизма.',
      },
      {
        name: 'Включите петлю на фразе',
        text: 'Два-четыре такта в повтор: не нужно каждый раз искать вступление, внимание остаётся на высоте и дыхании.',
      },
      {
        name: 'Поднимайте темп до рабочего',
        text: 'Когда фраза звучит ровно на медленном темпе, прибавляйте скорость шагами. Так распевка сразу переходит в репетицию, а не остаётся отдельным ритуалом.',
      },
    ],
  }),
  breadcrumbList([
    { name: 'Главная', path: '/' },
    { name: 'Распевка онлайн', path: '/raspevka-onlayn' },
  ]),
];
---

<Base {title} {description} canonicalPath="/raspevka-onlayn" {schemas}>
  <div class="wrap">
    <section class="hero">
      <p class="eyebrow">Вокал · перед пением</p>
      <h1>Распевка онлайн: десять минут, после которых голос слушается</h1>
      <p class="lede">
        Распевка нужна не для того, чтобы «разогреть связки» — она настраивает координацию
        между слухом и голосом. Десять минут в правильном порядке дают больше, чем полчаса
        громкого пения без плана.
      </p>
      <Cta label="Открыть студию" note="Репетиция в браузере, без установки" />
    </section>

    <section>
      <h2>Зачем распевка нужна на самом деле</h2>
      <p>
        Распевка не делает голос сильнее и не расширяет диапазон сама по себе. Она решает
        три задачи: снимает вялость аппарата после сна или молчания, настраивает слух на
        контроль высоты и возвращает привычку держать ровный выдох.
      </p>
      <p>
        Поэтому распевка — не ритуал «для галочки» и не разминка перед спортом. Это короткая
        настройка, после которой вы поёте точнее. Если после десяти минут упражнений вы не
        заметили разницы в первой же фразе песни — что-то в порядке упражнений не то.
      </p>
    </section>

    <section>
      <h2>Как устроена правильная распевка</h2>
      <p>
        Четыре правила, которые важнее конкретных упражнений.
      </p>
      <ul>
        <li><strong>Снизу вверх, а не сверху.</strong> Начинайте в удобной середине, поднимайтесь шагами. Высокие ноты в начале — самый быстрый путь к зажиму.</li>
        <li><strong>Тихо, потом громче.</strong> Громкость добавляется последней: она маскирует промахи, а на старте нужно их слышать.</li>
        <li><strong>Гласные важнее слов.</strong> На распевке работают «ми», «мэ», «ма», «а» — они не дают спрятать неточность за согласными.</li>
        <li><strong>Без давления.</strong> Если тянет «дожать» ноту горлом, значит, вы взяли не свою высоту. Опуститесь на полутон и вернитесь позже.</li>
      </ul>
    </section>

    <section>
      <h2>Программа на десять минут</h2>
      <p>
        Порядок важен: сначала дыхание, потом координация, потом диапазон, и только в конце —
        песня. Пять блоков, каждый со своей задачей.
      </p>
      <ol class="steps">
        <li>
          <h3>1 минута — выдох</h3>
          <p>Тяните «с» на ровном выдохе. Вдох на четыре счёта, выдох на восемь-двенадцать. Задача — ровная струя, без толчков.</p>
        </li>
        <li>
          <h3>2 минуты — мычание</h3>
          <p>Закрытый звук «м» на одной удобной ноте. Ищите, где звук отзывается в груди и в голове. Затем скольжение вверх-вниз в пределах половины октавы.</p>
        </li>
        <li>
          <h3>3 минуты — гласные по полутонам</h3>
          <p>«Ми-мэ-ма-мо-му» на одном слоге за раз, поднимаясь по полутонам до удобной границы и обратно. Медленно, без спешки.</p>
        </li>
        <li>
          <h3>2 минуты — арпеджио</h3>
          <p>До-ми-соль-ми-до на «а», ровным выдохом. Это самое честное упражнение: на нём слышно, держите ли вы высоту или сползаете.</p>
        </li>
        <li>
          <h3>2 минуты — фраза из песни</h3>
          <p>Та самая фраза, ради которой вы сели заниматься, — на медленном темпе и в петле. Распевка должна заканчиваться не упражнением, а музыкой.</p>
        </li>
      </ol>
    </section>

    <section>
      <h2>Как это выглядит в студии</h2>
      <p>
        Пятый блок и есть переход в репетицию — если студия уже открыта, распевка не
        заканчивается, а продолжается.
      </p>
      <ol class="steps">
        <li>
          <h3>Медленный темп</h3>
          <p>Фраза из песни на комфортной скорости, в своей тональности. Никакого героизма на распевке.</p>
        </li>
        <li>
          <h3>Петля на фразе</h3>
          <p>Два-четыре такта в повтор: внимание остаётся на высоте и дыхании, а не на поиске вступления.</p>
        </li>
        <li>
          <h3>Темп до рабочего</h3>
          <p>Прибавляйте скорость шагами, пока фраза не зазвучит в оригинальном темпе. Распевка перетекла в работу над песней.</p>
        </li>
      </ol>
    </section>

    <section>
      <h2>Четыре ошибки, которые портят распевку</h2>
      <ul>
        <li>Начинать с высоких нот — получается не распевка, а борьба с голосом.</li>
        <li>Петь на полной громкости с первой минуты — промахи не слышно, усталость приходит раньше результата.</li>
        <li>Распеваться дольше пятнадцати минут — это уже нагрузка, а не настройка.</li>
        <li>Заканчивать упражнениями, не спев ни одной фразы песни — теряется связь между распевкой и пением.</li>
      </ul>
    </section>

    <section>
      <h2>Что появится в студии</h2>
      <SoonNote>
        <p>
          ИИ-коуч по вокалу — в работе. Он будет показывать измеренное: насколько точно вы
          держите ноту, где сползли, как это меняется от попытки к попытке.
        </p>
        <p>
          Пока коуч не включён, для распевки уже есть всё нужное: замедление без смены
          тональности и петля на фрагменте.
        </p>
      </SoonNote>
    </section>

    <section>
      <h2>Частые вопросы</h2>
      {faq.map(({ q, a }) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </section>

    <section>
      <h2>Распевка — только начало</h2>
      <p>
        Десять минут настраивают голос, но не заменяют работу над песней. Дальше — разбор
        фрагментов и план на первые недели: об этом в материале
        <a href="/nauchitsya-pet">«научиться петь»</a>.
      </p>
      <Cta label="Открыть студию" note="Бесплатно, без установки" />
    </section>
  </div>
</Base>
