{
  "name": "belive",
  "version": "1.0.0",
  "description": "beLive — musical PWA for rehearsal, karaoke and live performance.",
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@libraz/libsonare": "^1.0.2",
    "jszip": "^3.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "mkdir -p public/team-m && cp -f team-m/INBOX.md public/team-m/INBOX.md",
    "build": "vite build && cp -r js dist/js",
    "preview": "vite preview",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives",
    "verify:asany": "node scripts/verify-asany.mjs",
    "verify:events": "npx tsx scripts/verify-event-map.ts",
    "verify:parity": "npx tsx scripts/verify-bridge-parity.ts",
    "verify:ci": "npm run verify:events && npm run verify:parity && npm run verify:reach && npm run verify:inert && npm run verify:docvis && npm run verify:junction && node scripts/check-eslint-directives.mjs",
    "verify:refs": "node scripts/verify-refs.mjs",
    "verify:reach": "node scripts/verify-reach.mjs",
    "probe:bundle": "node scripts/probe-bundle.mjs",
    "verify:docvis": "node scripts/verify-doc-visibility.mjs",
    "verify:inert": "node scripts/verify-inert.mjs",
    "verify:junction": "node scripts/verify-junction.mjs",
    "gen:docindex": "node scripts/gen-doc-index.mjs",
    "verify:permissions:local": "node team-m/tools/verify-permissions.mjs",
    "verify:jwt": "node scripts/smoke-jwt.mjs",
    "verify:typecheck": "node scripts/verify-typecheck.mjs",
    "verify:lint-baseline": "node scripts/verify-lint-baseline.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/side-chaine/beLive.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/side-chaine/beLive/issues"
  },
  "homepage": "https://side-chaine.github.io/beLive/",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/jszip": "^3.4.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/ui": "^4.1.6",
    "acorn": "^8.15.0",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "debug": "^4.4.1",
    "escape-string-regexp": "^4.0.0",
    "eslint": "^10.4.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^14.0.0",
    "ignore": "^5.3.2",
    "jsdom": "^28.1.0",
    "ms": "^2.1.3",
    "typescript": "^5.9.3",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.20.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.6",
    "workbox-window": "^7.4.0"
  }
}
