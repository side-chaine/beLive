diff --git a/src/components/S3VideoPanel.tsx b/src/components/S3VideoPanel.tsx
new file mode 100644
index 0000000..9b4078a
--- /dev/null
+++ b/src/components/S3VideoPanel.tsx
@@ -0,0 +1,52 @@
+import { useEffect, useRef } from 'react';
+import { useRehearsalSessionStore } from '../Rehearsal/store/rehearsal-session.store';
+
+/**
+ * S3 MVP-1 (Student-Педагог): teacher→student ОДНОСТОРОННЕЕ видео.
+ * - teacher: показывает СВОЙ поток (открыт/отправлен в deep-link.service при peer-joined).
+ * - student: НЕ открывает камеру (recvonly) → нет self-kill, нет glare.
+ * Single-initiator: только teacher аттачит трек + создаёт data-каналы.
+ */
+export function S3VideoPanel() {
+  const role = useRehearsalSessionStore((s) => s.role);
+  const remoteStream = useRehearsalSessionStore((s) => s.remoteStream);
+  const localStream = useRehearsalSessionStore((s) => s.localStream);
+  const connectionState = useRehearsalSessionStore((s) => s.connectionState);
+  const localVideoRef = useRef<HTMLVideoElement>(null);
+  const remoteVideoRef = useRef<HTMLVideoElement>(null);
+
+  useEffect(() => {
+    if (localVideoRef.current && localStream) localVideoRef.current.srcObject = localStream;
+  }, [localStream]);
+  useEffect(() => {
+    if (remoteVideoRef.current && remoteStream) remoteVideoRef.current.srcObject = remoteStream;
+  }, [remoteStream]);
+
+  if (!role) return null;
+
+  return (
+    <div className="s3-video-panel">
+      <div className="s3-badge">S3 · {role} · {connectionState}</div>
+      {role === 'teacher' && (
+        <div className="s3-local">
+          {localStream ? (
+            <video ref={localVideoRef} autoPlay playsInline muted />
+          ) : (
+            <div>📷…</div>
+          )}
+          <span>вы транслируете</span>
+        </div>
+      )}
+      {role === 'student' && (
+        <div className="s3-remote">
+          {remoteStream ? (
+            <video ref={remoteVideoRef} autoPlay playsInline />
+          ) : (
+            <div>🎥 ожидание преподавателя…</div>
+          )}
+          <span>видео преподавателя</span>
+        </div>
+      )}
+    </div>
+  );
+}
