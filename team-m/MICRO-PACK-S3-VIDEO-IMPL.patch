+let activeLocalStream: MediaStream | null = null;
+
+export function attachRehearsalLocalVideo(stream: MediaStream): void {
+  activePc?.attachLocalTracks(stream);
+}
+
+/** Открывает камеру teacher-а и аттачит к PC. Вызывается на peer-joined,
+ *  чтобы offer не потерялся до подключения student (perfect-negotiation). */
+async function startTeacherCamera(): Promise<void> {
+  try {
+    const stream = await navigator.mediaDevices.getUserMedia({
+      video: { facingMode: 'user' },
+      audio: false,
+    });
+    activeLocalStream = stream;
+    useRehearsalSessionStore.getState().setLocalStream(stream);
+    activePc?.attachLocalTracks(stream);
+  } catch (e) {
+    console.warn('[S3] teacher camera failed', e);
+  }
+}
